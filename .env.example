# --- Database (AWS RDS Postgres, me-central-1) ---
DATABASE_URL=postgresql://user:password@host:5432/noa
PG_POOL_MAX=5

# --- Stripe (test keys until NOA's live activation) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Vercel cron auth for /api/cron/expire-holds ---
CRON_SECRET=change-me

# --- Notifications (Day 3) ---
RESEND_API_KEY=re_...
EMAIL_FROM="NOA Dubai <reservations@noa-dubai.com>"
EMAIL_REPLY_TO=hello@noa-dubai.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+971...
TWILIO_STATUS_CALLBACK_URL=
# Meta-approved Content Template SIDs per template:locale, e.g. {"booking_confirmed:en":"HX...","booking_confirmed:ar":"HX..."}
WHATSAPP_CONTENT_SIDS={}
NEXT_PUBLIC_SITE_URL=https://noa-dubai.com
GUEST_SESSION_SECRET=   # 32+ random bytes; signs the guest session cookie

# --- Admin sign-in (Cognito admin user pool, me-central-1; roles from groups owner/editor/frontdesk) ---
NEXTAUTH_URL=https://noa-dubai.com
NEXTAUTH_SECRET=   # openssl rand -base64 32
COGNITO_ADMIN_CLIENT_ID=
COGNITO_ADMIN_CLIENT_SECRET=
COGNITO_ADMIN_ISSUER=https://cognito-idp.me-central-1.amazonaws.com/<pool-id>
